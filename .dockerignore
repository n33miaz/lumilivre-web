# Dependências e outputs (rebuildados dentro da imagem)
node_modules/
dist/

# Binários locais do app (APK vem de GitHub Release, ver README) — mandar 56 MB
# no contexto de build só para o Docker descartar é desperdício puro.
artifacts/
*.apk

# VCS / CI
.git/
.github/
.gitignore

# Env local — o build usa o ARG VITE_API_BASE_URL, nunca o .env do checkout
.env
.env.*
!.env.example

# Testes / tooling que não entram no bundle
e2e/
test-results/
playwright-report/
coverage/
playwright.config.ts
.code-review-graph/

# IDE / docs
.idea/
.vscode/
README.md
LICENSE

# Docker (evita invalidar cache ao editar o próprio Dockerfile)
Dockerfile
.dockerignore

*.log
